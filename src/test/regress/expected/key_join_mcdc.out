-- CTE projection path: skip an outer Var while projecting current key facts.
SELECT p.id, probe.ok
FROM mcdc_parent p,
LATERAL (
    WITH outer_cols AS (
        SELECT p.id AS outer_id, c.parent_id
        FROM mcdc_child c
    )
    SELECT true AS ok
    FROM outer_cols oc
    JOIN mcdc_parent pp FOR KEY (id) <- oc (parent_id)
    WHERE oc.outer_id = p.id AND pp.id = p.id
) probe
ORDER BY p.id;
 id | ok 
----+----
  1 | t
  2 | t
(2 rows)

-- Query projection path: system columns are not projected key facts.
SELECT r.id, q.id
FROM (
    SELECT p.id, p.ctid
    FROM mcdc_parent p
) q
JOIN mcdc_reader r FOR KEY (parent_id) -> q (id)
ORDER BY r.id;
 id  | id 
-----+----
 101 |  1
 202 |  2
(2 rows)

-- GROUP BY expression path: expression keys do not prove projected facts.
SELECT r.id, g.id
FROM (
    SELECT p.id + 0 AS id
    FROM mcdc_parent p
    GROUP BY p.id + 0
) g
JOIN mcdc_reader r FOR KEY (parent_id) -> g (id)
ORDER BY r.id;
ERROR:  key join from referencing relation r to referenced relation g cannot be proven at character 120
-- GROUP BY nondeterministic collation path: no projected key facts.
SELECT tr.id, g.id
FROM (
    SELECT p.id
    FROM mcdc_text_parent p
    GROUP BY p.id
) g
JOIN mcdc_text_reader tr FOR KEY (parent_id) -> g (id)
ORDER BY tr.id;
ERROR:  key join from referencing relation tr to referenced relation g cannot be proven at character 118
-- GROUP BY binary-compatible equality identity path: no projected key facts.
SELECT rr.id, g.id
FROM (
    SELECT p.id
    FROM mcdc_regclass_parent p
    GROUP BY p.id
) g
JOIN mcdc_regclass_reader rr FOR KEY (parent_id) -> g (id)
ORDER BY rr.id;
ERROR:  key join from referencing relation rr to referenced relation g cannot be proven at character 126
-- Non-domain relabel filters are not canonical key filters.
SELECT vr.id, v.id
FROM mcdc_text_cast_filter_v v
JOIN mcdc_text_cast_reader vr FOR KEY (parent_id) -> v (id)
ORDER BY vr.id;
ERROR:  key join from referencing relation vr to referenced relation v cannot be proven at character 81
-- Domain relabel filters must keep the normalized base typmod.
SELECT nr.id, v.id
FROM mcdc_numdom_typmod_filter_v v
JOIN mcdc_numdom_reader nr FOR KEY (parent_id) -> v (id)
ORDER BY nr.id;
ERROR:  key join from referencing relation nr to referenced relation v cannot be proven at character 82
-- Varchar opclasses can use either varchar or text equality input.
SELECT c.id, g.id
FROM (
    SELECT p.id
    FROM mcdc_varchar_parent p
    GROUP BY p.id
) g
JOIN mcdc_varchar_child c FOR KEY (parent_id) -> g (id)
ORDER BY c.id;
ERROR:  key join from referencing relation c to referenced relation g cannot be proven at character 121
-- Same-domain FK operators must use the normalized base equality type.
SELECT c.id, p.id
FROM mcdc_sig_parent p
JOIN mcdc_sig_child c FOR KEY (parent_id) -> p (id)
ORDER BY c.id;
ERROR:  key join from referencing relation c to referenced relation p cannot be proven at character 64
-- Procedure dependents without stored SQL bodies have nothing to revalidate.
CREATE FUNCTION mcdc_support_func(internal)
RETURNS internal
LANGUAGE internal STRICT
AS 'textlike_support';
CREATE FUNCTION mcdc_support_subject(int) RETURNS int
LANGUAGE sql STABLE SUPPORT mcdc_support_func
AS $$ SELECT $1 $$;
ALTER FUNCTION mcdc_support_func(internal) STABLE;
DROP FUNCTION mcdc_support_subject(int);
DROP FUNCTION mcdc_support_func(internal);
DROP VIEW mcdc_stable_filter_v;
DROP OPERATOR === (int, int);
DROP FUNCTION mcdc_stable_int_eq(int, int);
DROP VIEW mcdc_hash_filter_reader_v;
DROP VIEW mcdc_hash_filter_parent_v;
DROP OPERATOR CLASS mcdc_hash_bridge_int_ops USING hash;
DROP OPERATOR FAMILY mcdc_hash_bridge_ops USING hash;
DROP OPERATOR FAMILY mcdc_btree_bridge_ops USING btree;
DROP OPERATOR =## (int, bigint);
DROP FUNCTION mcdc_hash_bridge_eq(int, bigint);
DROP TABLE mcdc_text_reader, mcdc_text_parent;
DROP VIEW mcdc_text_cast_filter_v;
DROP TABLE mcdc_text_cast_reader, mcdc_text_cast_parent;
DROP TABLE mcdc_regclass_reader, mcdc_regclass_parent;
DROP TABLE mcdc_varchar_child, mcdc_varchar_parent;
DROP OPERATOR CLASS mcdc_varchar_ops USING btree;
DROP OPERATOR FAMILY mcdc_varchar_ops USING btree;
DROP FUNCTION mcdc_varchar_cmp(varchar, varchar);
DROP OPERATOR === (varchar, varchar);
DROP FUNCTION mcdc_varchar_eq(varchar, varchar);
DROP VIEW mcdc_numdom_typmod_filter_v;
DROP TABLE mcdc_numdom_reader, mcdc_numdom_parent;
DROP DOMAIN mcdc_num_dom;
DROP TABLE mcdc_sig_child, mcdc_sig_parent;
DROP OPERATOR CLASS mcdc_sig_dom_ops USING btree;
DROP OPERATOR FAMILY mcdc_sig_dom_ops USING btree;
DROP OPERATOR === (mcdc_sig_dom, mcdc_sig_dom);
DROP FUNCTION mcdc_sig_dom_cmp(mcdc_sig_dom, mcdc_sig_dom);
DROP FUNCTION mcdc_sig_dom_eq(mcdc_sig_dom, mcdc_sig_dom);
DROP DOMAIN mcdc_sig_dom;
DROP COLLATION mcdc_nondet;
DROP SCHEMA key_join_mcdc CASCADE;
NOTICE:  drop cascades to 23 other objects
